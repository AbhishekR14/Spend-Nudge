<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="22dp"
            android:text="@string/tagline"
            android:textSize="15sp" />

        <!-- Setup -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_setup" />

            <LinearLayout style="@style/StatusRow">
                <ImageView
                    android:id="@+id/icSms"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/perm_sms"
                    android:src="@drawable/ic_check" />

                <TextView
                    style="@style/StatusLabel"
                    android:text="@string/perm_sms" />
            </LinearLayout>

            <LinearLayout style="@style/StatusRow">
                <ImageView
                    android:id="@+id/icNotif"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/perm_notifications"
                    android:src="@drawable/ic_check" />

                <TextView
                    style="@style/StatusLabel"
                    android:text="@string/perm_notifications" />
            </LinearLayout>

            <LinearLayout style="@style/StatusRow">
                <ImageView
                    android:id="@+id/icTracker"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/tracker_installed"
                    android:src="@drawable/ic_check" />

                <TextView
                    style="@style/StatusLabel"
                    android:text="@string/tracker_installed" />
            </LinearLayout>

            <TextView
                android:id="@+id/hint"
                style="@style/Body"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/grant"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/grant" />

            <Button
                android:id="@+id/appInfo"
                style="@style/SecondaryButton"
                android:text="@string/app_info" />
        </LinearLayout>

        <!-- Nudges -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_nudges" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="12dp"
                    android:paddingStart="0dp"
                    android:text="@string/notify_credits"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/credits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/screenLabel"
                style="@style/Body" />

            <Button
                android:id="@+id/pickScreen"
                style="@style/SecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/pick_screen" />

            <Button
                android:id="@+id/showDetails"
                style="@style/SecondaryButton"
                android:text="@string/show_details" />
        </LinearLayout>

        <!-- Parser tester -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_test" />

            <TextView
                style="@style/Body"
                android:text="@string/test_blurb" />

            <EditText
                android:id="@+id/testInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="@string/test_hint"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:padding="14dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/testBtn"
                style="@style/PrimaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/test" />

            <TextView
                android:id="@+id/testResult"
                style="@style/Body"
                android:layout_marginTop="14dp"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            style="@style/Body"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
