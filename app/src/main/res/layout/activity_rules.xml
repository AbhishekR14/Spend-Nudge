<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Body"
            android:layout_marginBottom="18dp"
            android:text="@string/rules_blurb" />

        <!-- Which way the money went -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/nudge_me_for" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="12dp"
                    android:text="@string/money_out"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/notifyDebits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="12dp"
                    android:text="@string/money_in"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/notifyCredits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spend wordings -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/words_debit" />

            <TextView
                style="@style/Body"
                android:layout_marginBottom="6dp"
                android:text="@string/words_debit_blurb" />

            <LinearLayout
                android:id="@+id/debitList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/addDebit"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/add_word" />
        </LinearLayout>

        <!-- Income wordings -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/words_credit" />

            <TextView
                style="@style/Body"
                android:layout_marginBottom="6dp"
                android:text="@string/words_credit_blurb" />

            <LinearLayout
                android:id="@+id/creditList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/addCredit"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/add_word" />
        </LinearLayout>

        <!-- Ignore wordings -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/words_ignore" />

            <TextView
                style="@style/Body"
                android:layout_marginBottom="6dp"
                android:text="@string/words_ignore_blurb" />

            <LinearLayout
                android:id="@+id/ignoreList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/addIgnore"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/add_word" />
        </LinearLayout>

        <Button
            android:id="@+id/reset"
            style="@style/SecondaryButton"
            android:layout_marginTop="4dp"
            android:text="@string/reset"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
